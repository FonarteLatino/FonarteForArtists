// =============================================================================
// Prisma Schema — fonarte_portal database
// Base de datos de PERMISOS y AUTENTICACIÓN, separada de fonarte2 (Azure SQL)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Conexión a fonarte_portal (Azure SQL, base separada de fonarte2)
  // La cadena de conexión viene de Azure Key Vault vía variable de entorno.
  provider = "sqlserver"
  url      = env("DATABASE_URL_PORTAL")
}

// =============================================================================
// MÓDULO DE ORGANIZACIÓN (jerarquía Sello → Artista)
// =============================================================================

model Sello {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(500)
  creadoEn  DateTime  @default(now()) @map("creado_en")

  artistas  Artista[]

  @@map("sellos")
}

model Artista {
  id       Int    @id @default(autoincrement())
  selloId  Int    @map("sello_id")
  nombre   String @db.VarChar(500)

  sello     Sello               @relation(fields: [selloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios  Usuario[]
  entidades EntidadCatalogo[]

  @@map("artistas")
}

// =============================================================================
// MÓDULO DE CATÁLOGO (referencia a fonarte2, solo lectura)
// Almacena el ID de referencia (ISRC/UPC) que existe en fonarte2,
// sin duplicar los datos de streaming ni datos monetarios.
// =============================================================================

model EntidadCatalogo {
  id                   Int      @id @default(autoincrement())
  artistaId            Int      @map("artista_id")
  tipo                 String   @db.VarChar(20) // ALBUM, CANCION, VIDEO
  referenciaIdFonarte2 String   @map("referencia_id_en_fonarte2") @db.VarChar(200)
  nombre               String?  @db.VarChar(500)
  creadoEn             DateTime @default(now()) @map("creado_en")

  artista              Artista  @relation(fields: [artistaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([artistaId, tipo])
  @@index([referenciaIdFonarte2])
  @@map("entidades_catalogo")
}

// =============================================================================
// MÓDULO DE USUARIOS
// Cuentas provistas exclusivamente por administradores (sin autoregistro).
// =============================================================================

model Usuario {
  id            Int      @id @default(autoincrement())
  artistaId     Int?     @map("artista_id") // null = admin, int = artista vinculado
  email         String   @unique @db.VarChar(500)
  hashPassword  String?  @map("hash_password") @db.VarChar(1000) // Hash Argon2id; null si pendiente de activación
  esAdmin       Boolean  @default(false) @map("es_admin")
  activo        Boolean  @default(true)
  mfaHabilitado Boolean  @default(false) @map("mfa_habilitado")
  mfaSecret     String?  @map("mfa_secret") @db.VarChar(500) // Secreto TOTP cifrado
  creadoPor     Int?     @map("creado_por") // usuario_id del admin creador
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  artista              Artista?               @relation(fields: [artistaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitaciones         InvitacionActivacion[]
  concesionesOtorgadas ConcesionAcceso[]      @relation("UsuarioConcedente")
  concesiones          ConcesionAcceso[]      @relation("UsuarioConcedido")
  refreshTokens        RefreshToken[]
  auditoria            AuditoriaAcceso[]

  @@map("usuarios")
}

// =============================================================================
// MÓDULO DE INVITACIONES (flujo de provisión sin transmitir contraseñas)
// Enlace de un solo uso con token criptográfico SHA-256 de alta entropía.
// =============================================================================

model InvitacionActivacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiraEn  DateTime  @map("expira_en")
  usadaEn   DateTime? @map("usada_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tokenHash])
  @@map("invitaciones_activacion")
}

// =============================================================================
// MÓDULO DE SESIONES (refresh tokens con rotación y hash)
// =============================================================================

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiraEn   DateTime  @map("expira_en")
  revocadoEn DateTime? @map("revocado_en")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  ipOrigen   String?   @map("ip_origen") @db.VarChar(50)

  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tokenHash])
  @@index([usuarioId, revocadoEn])
  @@map("refresh_tokens")
}

// =============================================================================
// MÓDULO DE PERMISOS (concesiones de acceso jerárquico y granular)
// Regla de resolución: "lo más específico gana"
// =============================================================================

model ConcesionAcceso {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  tipoEntidad String    @map("tipo_entidad") @db.VarChar(20) // SELLO, ARTISTA, ALBUM, CANCION, VIDEO
  entidadId   Int       @map("entidad_id") // ID en sellos, artistas o entidades_catalogo
  efecto      String    @db.VarChar(10) // ALLOW, DENY
  otorgadoPor Int       @map("otorgado_por")
  otorgadoEn  DateTime  @default(now()) @map("otorgado_en")
  revocadoEn  DateTime? @map("revocado_en") // null = activo, fecha = revocado

  usuario    Usuario   @relation("UsuarioConcedido", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  concedente Usuario   @relation("UsuarioConcedente", fields: [otorgadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuarioId, revocadoEn])
  @@index([usuarioId, tipoEntidad, entidadId, revocadoEn])
  @@map("concesiones_acceso")
}

// =============================================================================
// MÓDULO DE AUDITORÍA
// Registro inmutable de eventos de seguridad, autenticación y acceso a datos.
// =============================================================================

model AuditoriaAcceso {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  evento    String   @db.VarChar(50) // LOGIN_OK, LOGIN_FAIL, etc.
  detalle   String?  @db.VarChar(2000)
  ipOrigen  String?  @map("ip_origen") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  fecha     DateTime @default(now())

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([usuarioId, fecha])
  @@index([evento, fecha])
  @@map("auditoria_accesos")
}
