# =============================================================================
# FONARTE FOR ARTISTS — Backend Environment Variables
# In production, these values are injected from Azure Key Vault.
# NEVER commit real production connection strings or secrets.
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# Database: fonarte_portal (Permissions & Auth database - separate from fonarte2)
# Format for Azure SQL / SQL Server:
DATABASE_URL_PORTAL="sqlserver://fonarte2.database.windows.net:1433;database=fonarte_portal;user=fonarte_portal_app;password=YourPasswordHere;encrypt=true;trustServerCertificate=false;"

# Database: fonarte2 (Reporting / Stats - READ ONLY user fonarte_portal_reader)
# Never use admin credentials or user with write permissions here
DATABASE_URL_FONARTE2_READONLY="sqlserver://fonarte2.database.windows.net:1433;database=Reporteador;user=fonarte_portal_reader;password=YourReadOnlyPassword;encrypt=true;trustServerCertificate=false;"

# JWT Secrets (Generate high-entropy keys for production)
JWT_SECRET="fonarte-dev-secret-key-change-in-production-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="fonarte-refresh-dev-secret-key-change-in-production-min-32"
JWT_REFRESH_EXPIRATION="7d"

# Activation Token Expiration (hours)
INVITATION_TOKEN_EXPIRATION_HOURS=72

# CORS
CORS_ORIGINS="http://localhost:3000,https://artists.fonartelatino.com"
